# ===== Google OAuth (bắt buộc) – tạo ở https://console.cloud.google.com/apis/credentials =====
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# URL bạn mở tool trên trình duyệt. Redirect URI khai báo trong Google Cloud = BASE_URL + /oauth/callback
# Máy cá nhân / VPS qua SSH tunnel: http://localhost:8080
# VPS có domain + HTTPS:           https://transload.ten-mien-cua-ban.com
BASE_URL=http://localhost:8080

# Mật khẩu bảo vệ giao diện web (NÊN đặt khi chạy trên VPS)
APP_USERNAME=admin
APP_PASSWORD=

# Tuỳ chỉnh
PORT=8080
COPY_WORKERS=4
THROTTLE_PAUSE_MINUTES=60
MAX_ATTEMPTS=5
TZ=Asia/Ho_Chi_Minh
